#!/usr/bin/make -f

build:	
	make -C hpi-lib
	make -C hpi-cli-apps

binary:	build
	dh_testroot
	dh_prep

#
# hpklinux-dev
#
	mkdir -p debian/hpklinux-dev/usr/lib
	cp -P hpi-lib/libhpimux.so debian/hpklinux-dev/usr/lib/
	cp -P hpi-lib/libhpi.so debian/hpklinux-dev/usr/lib/
	cp -P hpi-lib/libhpiudp.so debian/hpklinux-dev/usr/lib/
	cp hpi-lib/libhpiudp.a debian/hpklinux-dev/usr/lib/
	mkdir -p debian/hpklinux-dev/usr/include/asihpi
	cp hpi-lib/hpi.h debian/hpklinux-dev/usr/include/asihpi/
	cp hpi-lib/hpi_version.h debian/hpklinux-dev/usr/include/asihpi/

#
# hpklinux
#
	mkdir -p debian/hpklinux/usr/lib
	cp -P hpi-lib/libhpimux.so.10* debian/hpklinux/usr/lib/
	cp -P hpi-lib/libhpi.so.10* debian/hpklinux/usr/lib/
	cp -P hpi-lib/libhpiudp.so.10* debian/hpklinux/usr/lib/
	mkdir -p debian/hpklinux/usr/bin
	cp hpi-cli-apps/asi_firmware_updater debian/hpklinux/usr/bin/
	cp hpi-cli-apps/asihpiassert debian/hpklinux/usr/bin/
	cp hpi-cli-apps/asihpibl debian/hpklinux/usr/bin/
	cp hpi-cli-apps/asihpiplay debian/hpklinux/usr/bin/
	cp hpi-cli-apps/asihpirds debian/hpklinux/usr/bin/
	cp hpi-cli-apps/asihpirec debian/hpklinux/usr/bin/
	cp hpi-cli-apps/asihpi_si4688 debian/hpklinux/usr/bin/
	cp hpi-cli-apps/asihpitest debian/hpklinux/usr/bin/
	cp hpi-cli-apps/asihpitune debian/hpklinux/usr/bin/

	# --- BINDINGS Y HERRAMIENTAS PYTHON (asi-python) ---
	if [ -d asi-python/audioscience ]; then \
		mkdir -p debian/hpklinux/usr/lib/python3/dist-packages/audioscience; \
		cp -a asi-python/audioscience/* debian/hpklinux/usr/lib/python3/dist-packages/audioscience/; \
	fi
	if [ -f asi-python/hpicontrol.py ]; then \
		install -m 755 asi-python/hpicontrol.py debian/hpklinux/usr/bin/hpicontrol.py; \
		ln -sf hpicontrol.py debian/hpklinux/usr/bin/hpicontrol; \
	fi
	if [ -f asi-python/hpisave.py ]; then \
		install -m 755 asi-python/hpisave.py debian/hpklinux/usr/bin/hpisave.py; \
		ln -sf hpisave.py debian/hpklinux/usr/bin/hpisave; \
	fi
	if [ -f asi-python/hpimixer.py ]; then \
		install -m 755 asi-python/hpimixer.py debian/hpklinux/usr/bin/hpimixer.py; \
		ln -sf hpimixer.py debian/hpklinux/usr/bin/hpimixer; \
	fi
	
	# --- INICIO BLOQUE DKMS SANEADO ---
	mkdir -p debian/hpklinux/usr/src/snd-asihpi-@ASIHPI_VERSION@
	cp -a alsa-drv/* debian/hpklinux/usr/src/snd-asihpi-@ASIHPI_VERSION@/
	sed -i '/SOURCE_DIR_NAME/d' debian/hpklinux/usr/src/snd-asihpi-@ASIHPI_VERSION@/dkms.conf
	sed -i 's|/kernel/sound/pci/asihpi|/updates/dkms|' debian/hpklinux/usr/src/snd-asihpi-@ASIHPI_VERSION@/dkms.conf
	# --- FIN BLOQUE DKMS SANEADO ---

	# --- SERVICIO DE CARGA RETRASADA ---
	mkdir -p debian/hpklinux/lib/systemd/system
	cp debian/hpklinux.service debian/hpklinux/lib/systemd/system/

	mkdir -p debian/hpklinux/usr/share/doc/hpklinux
	cp debian/README debian/hpklinux/usr/share/doc/hpklinux/
	dh_strip_nondeterminism
	dh_compress
	dh_fixperms
	dh_missing
	dh_dwz
	dh_strip
	dh_makeshlibs
	dh_shlibdeps -- --ignore-missing-info
	dh_installdeb
	dh_gencontrol
	dh_md5sums
	dh_builddeb

%:
	dh $@
