#!/bin/sh
# postinst script for hpklinux

case "$1" in
    configure)
	ldconfig

	# Driver ALSA (Incluye la API HPI nativa internamente)
	dkms add -m snd-asihpi -v @ASIHPI_VERSION@
	dkms build -m snd-asihpi -v @ASIHPI_VERSION@
	dkms install -m snd-asihpi -v @ASIHPI_VERSION@

	# Activar la carga en el arranque
	systemctl daemon-reload
	systemctl enable --now hpklinux.service
	;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
