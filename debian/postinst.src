#!/bin/sh
# postinst script for hpklinux

case "$1" in
    configure)
	ldconfig

	# Driver HPI Nativo
	dkms add -m asihpi -v @ASIHPI_VERSION@
	dkms build -m asihpi -v @ASIHPI_VERSION@
	dkms install -m asihpi -v @ASIHPI_VERSION@

	# Driver ALSA
	dkms add -m snd-asihpi -v @ASIHPI_VERSION@
	dkms build -m snd-asihpi -v @ASIHPI_VERSION@
	dkms install -m snd-asihpi -v @ASIHPI_VERSION@

	/bin/systemctl daemon-reload
	;;

    abort-upgrade|abort-remove|abort-deconfigure)
    ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
